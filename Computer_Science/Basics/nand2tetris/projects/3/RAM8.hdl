// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:

    DMux8Way(in=load , sel=address , a=inA , b=inB ,
            c=inC , d=inD , e=inE , f=inF , g=inG , h=inH );
    Register(in=in , load=inA , out=memA );
    Register(in=in , load=inB , out=memB );
    Register(in=in , load=inC , out=memC );
    Register(in=in , load=inD , out=memD );
    Register(in=in , load=inE , out=memE );
    Register(in=in , load=inF , out=memF );
    Register(in=in , load=inG , out=memG );
    Register(in=in , load=inH , out=memH );
    
    Mux8Way16(a=memA , b=memB , c=memC ,
              d=memD , e=memE , f=memF ,
              g=memG , h=memH , sel=address , out=out );
}
